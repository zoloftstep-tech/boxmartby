# Скопируйте в .env.local и заполните реальными значениями.
# Файл .env.local не коммитится (.gitignore).

# CRM ingest (фаза 2 cutover) — тот же секрет, что INGEST_SITE_SECRET на CRM
CRM_INGEST_URL=https://boxmart-crm.vercel.app/api/ingest/site
INGEST_SITE_SECRET=

# Telegram: бот @BotFather + Chat ID приватной группы (отрицательное число)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Секрет для webhook (X-Telegram-Bot-Api-Secret-Token). Случайная строка.
# После деплоя один раз: setWebhook с secret_token — см. DEPLOY.md
TELEGRAM_WEBHOOK_SECRET=

# Парсер-бот: новый токен, отдельный секрет webhook, PERPLEXITY для распознавания заявок
TELEGRAM_PARSER_BOT_TOKEN=
TELEGRAM_PARSER_WEBHOOK_SECRET=
PERPLEXITY_API_KEY=

# Gmail: аккаунт + App Password (не обычный пароль от почты)
GMAIL_USER=info@boxmart.by
GMAIL_APP_PASSWORD=

# Google tag (Ads / Analytics). Публичный идентификатор — виден в HTML.
NEXT_PUBLIC_GTAG_ID=AW-18383822231
# Событие конверсии на /spasibo (send_to из Google Ads).
NEXT_PUBLIC_GTAG_CONVERSION=AW-18383822231/KSu4CIi1gOAcEJe7i75E

# Production-домен сайта (Origin). Для локальной разработки localhost:3000
# разрешён автоматически в development.
ALLOWED_ORIGIN=https://www.boxmart.by

# Калькулятор BoxCalc — org defaults + расчёт
# Тот же ключ, что DEFAULTS_API_KEY в проекте boxcalculator.
# Кэш defaults ~60 с; при ошибке/отсутствии env — локальный pricing-config.ts.
CALCULATOR_DEFAULTS_URL=https://boxcalculator-sand.vercel.app/api/defaults
CALCULATOR_DEFAULTS_API_KEY=
# Опционально: явный URL расчёта (иначе выводится из DEFAULTS_URL → /api/calculate)
# CALCULATOR_CALCULATE_URL=https://boxcalculator-sand.vercel.app/api/calculate

# Phase G: Bearer для GET /api/cron/pricing-contract (Vercel cron каждые 6ч; TG alert при fail)
CRON_SECRET=CRON_SECRET=43a05a685f215b66807203a604f87463a2e10eeb6bb60743a3f01e9bd340e7d2

# Опционально: origin сайта для live contract script (SITE_ORIGIN=https://boxmartby.vercel.app)
# SITE_ORIGIN=

# Опционально: дополнительные Origin через запятую (staging и т.п.)
# ALLOWED_ORIGINS=https://staging.boxmart.by,http://localhost:3000
