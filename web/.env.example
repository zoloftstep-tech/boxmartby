# Скопируйте в .env.local и заполните реальными значениями.
# Файл .env.local не коммитится (.gitignore).

# Telegram: бот @BotFather + Chat ID приватной группы (отрицательное число)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Секрет для webhook (X-Telegram-Bot-Api-Secret-Token). Случайная строка.
# После деплоя один раз: setWebhook с secret_token — см. DEPLOY.md
TELEGRAM_WEBHOOK_SECRET=

# Gmail: аккаунт + App Password (не обычный пароль от почты)
GMAIL_USER=info@boxmart.by
GMAIL_APP_PASSWORD=

# Production-домен сайта (Origin). Для локальной разработки localhost:3000
# разрешён автоматически в development.
ALLOWED_ORIGIN=https://boxmart.by

# Опционально: дополнительные Origin через запятую (staging и т.п.)
# ALLOWED_ORIGINS=https://staging.boxmart.by,http://localhost:3000
